# FREE option: one Gemini key powers both scripts and voices.
# Get it at https://aistudio.google.com/apikey (no credit card needed).
GEMINI_API_KEY=
# Optional model overrides
GEMINI_MODEL=
GEMINI_TTS_MODEL=

# Paid options
# Claude writes scripts. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional: override the Claude model (defaults to claude-opus-5-5)
CLAUDE_MODEL=
# OpenAI text-to-speech voices
OPENAI_API_KEY=

# Optional: if set, visitors must enter this code to use YOUR keys.
# Visitors can always paste their own keys in Settings instead.
ACCESS_CODE=
