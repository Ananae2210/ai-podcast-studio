# Claude writes the scripts. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-5-5)
CLAUDE_MODEL=

# OpenAI text-to-speech for the voices. Optional: without it the app uses the browser's built-in voices.
OPENAI_API_KEY=

# Optional: if set, visitors must enter this code to use YOUR keys.
# Visitors can always paste their own keys in Settings instead.
ACCESS_CODE=
